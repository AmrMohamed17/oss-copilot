# --- Secrets: the single most important lines in this file ---
.env
*.pem
*.key

# --- Raw data: large and re-fetchable. Fixtures under data/fixtures ARE committed. ---
data/raw/*
!data/raw/.gitkeep

# --- Python ---
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# --- Tooling / OS ---
.ipynb_checkpoints/
.DS_Store
.idea/
.vscode/
